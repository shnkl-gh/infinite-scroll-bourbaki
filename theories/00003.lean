/-- Look up entry `i` of a finite table, as an element of `Fin n`. -/
def tbl (L : List Nat) (n : Nat) (h : 0 < n) (i : Nat) : Fin n :=
  ⟨L.getD i 0 % n, Nat.mod_lt _ h⟩

class Structure (E : Type) where
  op : E → E → E
  φ : E → E
  ax1 : ∀ x y : E, op x (op x x) = φ y

open Structure
infixl:70 " ⋆ " => Structure.op

section
variable {E : Type} [Structure E]

def d1 (a : E) : Prop := ∀ x : E, a = (φ x) ⋆ (x ⋆ a)
def d2 (a : E) : Prop := ∀ x : E, (a ⋆ a) ⋆ (x ⋆ x) = (a ⋆ x) ⋆ x
def d3 (a : E) : Prop := ∀ x : E, a = (x ⋆ a) ⋆ (φ a)
def d4 (a : E) : Prop := ∀ x : E, d2 x → d2 (a ⋆ x)

/-! ## Theorems (formal step) -/

/-- The value of `φ` at `x` is the cube `x ⋆ (x ⋆ x)`. -/
theorem phi_eq_cube (x : E) : φ x = x ⋆ (x ⋆ x) := (ax1 x x).symm

/-- `φ` is constant. -/
theorem phi_const (y y' : E) : φ y = φ y' := by
  rw [← ax1 y y, ← ax1 y y']

/-- All cubes `x ⋆ (x ⋆ x)` are equal. -/
theorem cube_const (x x' : E) : x ⋆ (x ⋆ x) = x' ⋆ (x' ⋆ x') := by
  rw [ax1 x x, ax1 x' x]

/-- The common value `c` of `φ` is its own cube. -/
theorem apex_cube (y : E) : φ y ⋆ (φ y ⋆ φ y) = φ y := ax1 (φ y) y

/-- `φ ∘ φ = φ`. -/
theorem phi_idem (y : E) : φ (φ y) = φ y := phi_const _ _


end

/-- Conversely: a law whose cubes all equal `c`, with `φ` constant equal to `c`. -/
def ofConstCube (E : Type) (m : E → E → E) (c : E) (h : ∀ x, m x (m x x) = c) :
    Structure E where
  op := m
  φ := fun _ => c
  ax1 := fun x _ => h x

