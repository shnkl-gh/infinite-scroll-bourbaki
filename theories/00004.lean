/-- Look up entry `i` of a finite table, as an element of `Fin n`. -/
def tbl (L : List Nat) (n : Nat) (h : 0 < n) (i : Nat) : Fin n :=
  ⟨L.getD i 0 % n, Nat.mod_lt _ h⟩

class Structure (E : Type) where
  op : E → E → E
  φ : E → E
  e : E
  ax1 : ∀ x : E, op x x = φ x
  ax2 : ∀ x y : E, op y e = φ y → op (op y x) (op y x) = op (op e y) (op y y)

open Structure
infixl:70 " ⋆ " => Structure.op

section
variable {E : Type} [Structure E]

def d1 (a : E) : Prop := ∃ x : E, (φ x) ⋆ (φ a) = (x ⋆ x) ⋆ (a ⋆ x)
def d2 (a : E) : Prop := d1 a ∧ (∀ x : E, a ⋆ e = φ x)
def d3 (a : E) : Prop := ∀ x : E, x ⋆ (x ⋆ a) = φ (a ⋆ a)
def d4 (a : E) : Prop := ∃ x : E, φ (x ⋆ x) = a ⋆ (φ a)
def d5 (a : E) : Prop := ∀ x : E, (φ x) ⋆ (a ⋆ a) = (a ⋆ e) ⋆ (a ⋆ a)

/-! ## Theorems (formal step) -/

/-- `φ` is the squaring map. -/
theorem phi_sq (x : E) : φ x = x ⋆ x := (ax1 x).symm

/-- The squares of the left multiples of `e` are all equal. -/
theorem e_left_sq (x : E) : (e ⋆ x) ⋆ (e ⋆ x) = (e ⋆ e) ⋆ (e ⋆ e) :=
  ax2 x e (ax1 e)

/-- Every element satisfies `d1`: take `x = a`. -/
theorem d1_all (a : E) : d1 a := ⟨a, by rw [← ax1 a]⟩

/-- `d2 a` says exactly that every square equals `a ⋆ e`. -/
theorem d2_iff (a : E) : d2 a ↔ ∀ x : E, x ⋆ x = a ⋆ e := by
  constructor
  · intro h x
    rw [ax1]
    exact (h.2 x).symm
  · intro h
    refine ⟨d1_all a, fun x => ?_⟩
    rw [← ax1 x]
    exact (h x).symm

/-- `d2` implies `d5`. -/
theorem d2_d5 (a : E) (h : d2 a) : d5 a := by
  intro x
  rw [h.2 x]

/-- `d3` implies `d4`: take `x = a`. -/
theorem d3_d4 (a : E) (h : d3 a) : d4 a :=
  ⟨a, by rw [← h a, ← ax1 a]⟩


end

/-- Example: a semilattice law with an absorbing element `o`; `φ = id`, `e = o`. -/
def ofSemilatticeBot (E : Type) (m : E → E → E) (o : E)
    (hi : ∀ x, m x x = x) (hc : ∀ x y, m x y = m y x) (he : ∀ y, m y o = o) :
    Structure E where
  op := m
  φ := id
  e := o
  ax1 := fun x => hi x
  ax2 := by
    intro x y h
    have hy : y = o := by
      have h' : m y o = y := h
      rw [he] at h'
      exact h'.symm
    subst hy
    simp [hc y x, he]

/-- In this example, `d3 a` holds exactly when `a = o`. -/
theorem bot_d3_iff (E : Type) (m : E → E → E) (o : E)
    (hi : ∀ x, m x x = x) (hc : ∀ x y, m x y = m y x) (he : ∀ y, m y o = o) (a : E) :
    @d3 E (ofSemilatticeBot E m o hi hc he) a ↔ a = o := by
  have hz : ∀ z, m o z = o := fun z => by rw [hc, he]
  constructor
  · intro h
    have h1 : m o (m o a) = id (m a a) := h o
    rw [hz, id, hi] at h1
    exact h1.symm
  · intro ha
    subst ha
    intro x
    show m x (m x a) = id (m a a)
    simp [he]

