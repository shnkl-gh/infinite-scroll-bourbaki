    Structure E where
  op := m
  ax1 := by intro x y; rw [h, h]
  ax2 := by intro x y z; rw [h, h]

/-- A model on `{0, 1, 2}`: `1 ⋆ 1 = 2`, `2 ⋆ 0 = 1`, all other products `0`. -/
