/-- Look up entry `i` of a finite table, as an element of `Fin n`. -/
def tbl (L : List Nat) (n : Nat) (h : 0 < n) (i : Nat) : Fin n :=
  ⟨L.getD i 0 % n, Nat.mod_lt _ h⟩

class Structure (E : Type) where
  op : E → E → E
  φ : E → E
  ax1 : ∀ x y : E, φ (op x x) = op (op x y) y
  ax2 : ∀ x y : E, φ (φ y) = φ (op x y)

open Structure
infixl:70 " ⋆ " => Structure.op

section
variable {E : Type} [Structure E]

def d1 : Prop := ∀ x y : E, φ (φ x) = (y ⋆ y) ⋆ y
def d2 (a : E) : Prop := ∃ x : E, a = (φ x) ⋆ (x ⋆ a)
def d3 (a : E) : Prop := ∀ x : E, (x ⋆ x) ⋆ x = a ⋆ (x ⋆ x)

/-! ## Theorems (formal step) -/

/-- `φ (φ x) = φ (x ⋆ x)`. -/
theorem phiphi_sq (x : E) : φ (φ x) = φ (x ⋆ x) := ax2 x x

/-- The key identity: `φ (φ y) = φ (φ (φ x))` for all `x, y`. -/
theorem key (x y : E) : φ (φ y) = φ (φ (φ x)) := by
  rw [ax2 (x ⋆ y) y, ← ax1 x y, ← ax2 x x]

/-- `φ ∘ φ` is constant. -/
theorem phiphi_const (x y : E) : φ (φ x) = φ (φ y) := by
  rw [key y x, ← key y y]

/-- `(x ⋆ y) ⋆ y = φ (φ x)`. -/
theorem rsq (x y : E) : (x ⋆ y) ⋆ y = φ (φ x) := by
  rw [← ax1 x y, ← ax2 x x]

/-- All elements `(x ⋆ y) ⋆ y` are equal. -/
theorem rsq_const (x y x' y' : E) : (x ⋆ y) ⋆ y = (x' ⋆ y') ⋆ y' := by
  rw [rsq, rsq, phiphi_const x x']

/-- `φ` takes the same value on all products. -/
theorem phi_prod (z x w : E) : φ (z ⋆ x) = φ (φ w) := by
  rw [← ax2 z x, phiphi_const x w]

/-- The structure property `d1` holds in every structure. -/
theorem d1_holds : d1 (E := E) := by
  intro x y
  rw [rsq, phiphi_const x y]

/-- `d3 a` says that `a ⋆ (x ⋆ x)` is the constant `φ (φ a)` for every `x`. -/
theorem d3_iff (a : E) : d3 a ↔ ∀ x : E, a ⋆ (x ⋆ x) = φ (φ a) := by
  constructor
  · intro h x
    rw [← h x, rsq, phiphi_const x a]
  · intro h x
    rw [h x, rsq, phiphi_const x a]

/-- If `a = φ x ⋆ (x ⋆ a)`, then `a ⋆ (x ⋆ a)` is the constant. -/
theorem d2_witness (a x : E) (h : a = φ x ⋆ (x ⋆ a)) : a ⋆ (x ⋆ a) = φ (φ a) := by
  have h1 := rsq (φ x) (x ⋆ a)
  rw [← h] at h1
  rw [h1, phiphi_const (φ x) a]


end

