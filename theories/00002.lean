/-- Look up entry `i` of a finite table, as an element of `Fin n`. -/
def tbl (L : List Nat) (n : Nat) (h : 0 < n) (i : Nat) : Fin n :=
  ⟨L.getD i 0 % n, Nat.mod_lt _ h⟩

class Structure (E : Type) where
  op : E → E → E
  ρ : E → E → Prop
  ax1 : ∀ x y : E, op (op x x) (op x y) = op (op y y) (op x x)

open Structure
infixl:70 " ⋆ " => Structure.op

section
variable {E : Type} [Structure E]

def d1 (a : E) : Prop := ∀ x : E, ρ (a ⋆ x) (x ⋆ x)
def d2 (a : E) : Prop := ∃ x : E, (x ⋆ a) ⋆ (x ⋆ x) = (x ⋆ x) ⋆ (x ⋆ x)
def d3 (a : E) : Prop := ∃ x : E, (x ⋆ x) ⋆ (x ⋆ x) = (x ⋆ a) ⋆ (x ⋆ a)
def d4 : Prop := ∀ x y : E, (x ⋆ y) ⋆ x = x ⋆ y

/-! ## Theorems (formal step) -/

/-- Every element satisfies `d2`: take `x = a`. -/
theorem d2_all (a : E) : d2 a := ⟨a, rfl⟩

/-- Every element satisfies `d3`: take `x = a`. -/
theorem d3_all (a : E) : d3 a := ⟨a, rfl⟩


end

/-- The axiom does not involve `ρ`: it may be replaced by any relation. -/
def withRel {E : Type} (S : Structure E) (r : E → E → Prop) : Structure E :=
  { S with ρ := r }

/-- Example: a semilattice law (idempotent, commutative, associative). -/
def ofSemilattice (E : Type) (m : E → E → E) (r : E → E → Prop)
    (hi : ∀ x, m x x = x) (hc : ∀ x y, m x y = m y x)
    (ha : ∀ x y z, m (m x y) z = m x (m y z)) : Structure E where
  op := m
  ρ := r
  ax1 := by
    intro x y
    rw [hi, hi, ← ha, hi, hc]

/-- In a semilattice ordered by `u ≤ v ↔ m u v = u`, every element satisfies `d1`. -/
theorem ofSemilattice_d1 (E : Type) (m : E → E → E)
    (hi : ∀ x, m x x = x) (hc : ∀ x y, m x y = m y x)
    (ha : ∀ x y z, m (m x y) z = m x (m y z)) (a : E) :
    @d1 E (ofSemilattice E m (fun u v => m u v = u) hi hc ha) a := by
  intro x
  show m (m a x) (m x x) = m a x
  rw [hi, ha, hi]

/-- A semilattice satisfies `d4`. -/
theorem ofSemilattice_d4 (E : Type) (m : E → E → E) (r : E → E → Prop)
    (hi : ∀ x, m x x = x) (hc : ∀ x y, m x y = m y x)
    (ha : ∀ x y z, m (m x y) z = m x (m y z)) :
    @d4 E (ofSemilattice E m r hi hc ha) := by
  intro x y
  show m (m x y) x = m x y
  rw [hc (m x y) x, ← ha, hi]

/-- Example: all squares equal to an element `o` that absorbs on the left. -/
def absorbing (E : Type) (m : E → E → E) (r : E → E → Prop) (o : E)
    (hs : ∀ x, m x x = o) (ho : ∀ z, m o z = o) : Structure E where
  op := m
  ρ := r
  ax1 := by
    intro x y
    rw [hs, hs, ho, ho]

/-- The law `x ⋆ y = x ∧ ¬y` on `{0, 1}`: all squares are `0`, and `0` absorbs. -/
def exA : Structure (Fin 2) where
  op := fun a b => tbl [0, 0, 1, 0] 2 (by decide) (2 * a.val + b.val)
  ρ := fun _ _ => False
  ax1 := by decide

/-- `exA` does not satisfy `d4`, so `d4` is not a consequence of the axiom. -/
theorem exA_not_d4 : ¬ @d4 (Fin 2) exA := by
  unfold d4
  decide

