/-- A square acting on a square does not depend on the acting square. -/
theorem sqsq_left (z z' x : E) : (z ⋆ z) ⋆ (x ⋆ x) = (z' ⋆ z') ⋆ (x ⋆ x) := by
  rw [← ax2 x x z, ← ax2 x x z']

/-- `(x ⋆ y) ⋆ (y ⋆ y)` is the trace `(x ⋆ x) ⋆ x` of `x`. -/
theorem trace (x y : E) : (x ⋆ y) ⋆ (y ⋆ y) = (x ⋆ x) ⋆ x := by
  rw [ax2 x y x, ax1]

/-- `(z ⋆ z) ⋆ (x ⋆ x)` is the trace of `x`. -/
theorem sqsq_trace (z x : E) : (z ⋆ z) ⋆ (x ⋆ x) = (x ⋆ x) ⋆ x := by
  rw [sqsq_left z x x, ax1]

/-- If `a` satisfies `d1`, every square acting on `a ⋆ a` gives `a`. -/
theorem d1_sq (a : E) (h : d1 a) (z : E) : (z ⋆ z) ⋆ (a ⋆ a) = a := by
  rw [sqsq_left z a a]
  exact h a

/-- If `a` satisfies `d1`, `a` is its own trace. -/
theorem d1_trace (a : E) (h : d1 a) : (a ⋆ a) ⋆ a = a := by
  rw [← ax1 a]
  exact h a

/-- If `a` satisfies `d2`, the square of `a` is the trace of `a`. -/
theorem d2_sq (a : E) (h : d2 a) : a ⋆ a = (a ⋆ a) ⋆ a := by
  rw [← ax1 a]
  exact h a

/-- `d3` implies `d4`: take `x = a`. -/
theorem d3_d4 (a : E) (h : d3 a) : d4 a := ⟨a, h, rfl⟩


